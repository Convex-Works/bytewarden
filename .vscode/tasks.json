{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "browser: debug start",
      "type": "npm",
      "script": "debug:browser",
      "path": "",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "browser-debug",
        "pattern": [
          {
            "regexp": "^$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Building extension.*",
          "endsPattern": ".*DevTools:\\s+http://localhost.*"
        }
      }
    }
  ]
}
