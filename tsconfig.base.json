{
  "compilerOptions": {
    "strict": false,
    "pretty": true,
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2016",
    "module": "ES2020",
    "lib": ["es5", "es6", "es7", "dom", "ES2021", "ESNext.Disposable"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "outDir": "dist",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@bytewarden/admin-console/common": ["./libs/admin-console/src/common"],
      "@bytewarden/angular/*": ["./libs/angular/src/*"],
      "@bytewarden/assets": ["./libs/assets/src/index.ts"],
      "@bytewarden/assets/svg": ["./libs/assets/src/svg/index.ts"],
      "@bytewarden/auth/angular": ["./libs/auth/src/angular"],
      "@bytewarden/auth/common": ["./libs/auth/src/common"],
      "@bytewarden/auto-confirm": ["./libs/auto-confirm/src/index.ts"],
      "@bytewarden/auto-confirm/angular": ["./libs/auto-confirm/src/angular"],
      "@bytewarden/automation-driver": ["./libs/automation-driver/src/index.ts"],
      "@bytewarden/billing": ["./libs/billing/src"],
      "@bytewarden/browser/*": ["./apps/browser/src/*"],
      "@bytewarden/client-type": ["./libs/client-type/src/index.ts"],
      "@bytewarden/common/spec": ["./libs/common/spec"],
      "@bytewarden/common/*": ["./libs/common/src/*"],
      "@bytewarden/components": ["./libs/components/src"],
      "@bytewarden/core-test-utils": ["./libs/core-test-utils/src/index.ts"],
      "@bytewarden/dirt-card": ["./libs/dirt/card/src"],
      "@bytewarden/generator-components": ["./libs/tools/generator/components/src"],
      "@bytewarden/generator-core": ["./libs/tools/generator/core/src"],
      "@bytewarden/generator-history": ["./libs/tools/generator/extensions/history/src"],
      "@bytewarden/generator-legacy": ["./libs/tools/generator/extensions/legacy/src"],
      "@bytewarden/generator-navigation": ["./libs/tools/generator/extensions/navigation/src"],
      "@bytewarden/guid": ["./libs/guid/src/index.ts"],
      "@bytewarden/importer-core": ["./libs/importer/src"],
      "@bytewarden/importer-ui": ["./libs/importer/src/components"],
      "@bytewarden/key-management": ["./libs/key-management/src"],
      "@bytewarden/key-management-ui": ["./libs/key-management-ui/src"],
      "@bytewarden/legacy-crypto": ["./libs/legacy-crypto/src/index.ts"],
      "@bytewarden/legacy-crypto/node": ["./libs/legacy-crypto/src/node/index.ts"],
      "@bytewarden/legacy-crypto/*": ["./libs/legacy-crypto/src/*"],
      "@bytewarden/logging": ["./libs/logging/src"],
      "@bytewarden/logging-angular": ["./libs/logging-angular/src/index.ts"],
      "@bytewarden/messaging": ["./libs/messaging/src/index.ts"],
      "@bytewarden/node/*": ["./libs/node/src/*"],
      "@bytewarden/nx-plugin": ["./libs/nx-plugin/src/index.ts"],
      "@bytewarden/organization-invite-link": ["./libs/organization-invite-link/src/index.ts"],
      "@bytewarden/platform": ["./libs/platform/src"],
      "@bytewarden/platform/*": ["./libs/platform/src/*"],
      "@bytewarden/pricing": ["./libs/pricing/src/index.ts"],
      "@bytewarden/scheduling": ["./libs/scheduling/src/index.ts"],
      "@bytewarden/send-ui": ["./libs/tools/send/send-ui/src"],
      "@bytewarden/serialization": ["./libs/serialization/src/index.ts"],
      "@bytewarden/state": ["./libs/state/src/index.ts"],
      "@bytewarden/state-internal": ["./libs/state-internal/src/index.ts"],
      "@bytewarden/state-test-utils": ["./libs/state-test-utils/src/index.ts"],
      "@bytewarden/storage-core": ["./libs/storage-core/src/index.ts"],
      "@bytewarden/storage-test-utils": ["./libs/storage-test-utils/src/index.ts"],
      "@bytewarden/subscription": ["./libs/subscription/src/index.ts"],
      "@bytewarden/ui-common": ["./libs/ui/common/src"],
      "@bytewarden/ui-common/setup-jest": ["./libs/ui/common/src/setup-jest"],
      "@bytewarden/unlock": ["./libs/unlock/src/index.ts"],
      "@bytewarden/user-core": ["./libs/user-core/src/index.ts"],
      "@bytewarden/user-crypto-management": ["./libs/user-crypto-management/src/index.ts"],
      "@bytewarden/vault": ["./libs/vault/src"],
      "@bytewarden/vault-export-core": ["./libs/tools/export-vault-core/src"],
      "@bytewarden/vault-export-ui": ["./libs/tools/export-vault-ui/src"],
      "@bytewarden/pam": ["./libs/pam/src/index.ts"],
      "@bytewarden/storybook": ["./libs/storybook/src/index.ts"],
      "@bytewarden/managed-settings": ["./libs/managed-settings/src/index.ts"],
      "@bytewarden/tools-share": ["./libs/tools/share/src/index.ts"]
    },
    "plugins": [
      {
        "name": "typescript-strict-plugin"
      }
    ],
    "useDefineForClassFields": false
  }
}
